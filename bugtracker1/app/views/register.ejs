<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register | BugTracker</title>
  <link rel="stylesheet" href="/css/style.css" nonce="<%= nonce %>">
  <meta name="description" content="THEM?!CTF is the best ctf"> 
</head>
<body>
<div class="auth-container">
  <div class="auth-card">
    <h1>🐛 BugTracker</h1>
    <h2>Create Account</h2>
    <div id="msg" class="msg hidden"></div>
    <div class="form-group">
      <label>Username <span class="hint">(3-64 chars, alphanumeric + underscore)</span></label>
      <input type="text" id="username" name="username">
    </div>
    <div class="form-group">
      <label>Password <span class="hint">(8-128 chars)</span></label>
      <input type="password" id="password" name="password">
    </div>
    <button type="submit" class="btn btn-primary btn-full">Create Account</button>
    <p class="auth-link">Already have an account? <a href="/login">Sign in</a></p>
  </div>
</div>
<script nonce="<%= nonce %>">
document.querySelector('button').addEventListener('click', doRegister);

async function doRegister() {
  const username = document.getElementById('username').value;
  const password = document.getElementById('password').value;
  const resp = await fetch('/api/register', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: `username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}`
  });
  const data = await resp.json();
  const msg = document.getElementById('msg');
  if (data.status === 'ok') {
    msg.textContent = 'Account created! Redirecting to login...';
    msg.className = 'msg success';
    setTimeout(() => window.location.href = '/login', 1500);
  } else {
    msg.textContent = data.error || 'Registration failed';
    msg.className = 'msg error';
  }
}
</script>
</body>
</html>
