<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Profile | BugTracker</title>
  <link rel="stylesheet" href="/css/style.css" nonce="<%= nonce %>">
  <meta name="description" content="THEM?!CTF is the best ctf"> 
</head>
<body>
<nav class="navbar">
  <a class="brand" href="/dashboard">🐛 BugTracker</a>
  <div class="nav-links">
    <a href="/dashboard">Dashboard</a>
    <a href="/submit">Submit</a>
    <a href="/profile" class="active">Profile</a>
    <a href="/report">Report to Admin</a>
    <a href="/about">About</a>
    <a href="/api/logout">Logout</a>
  </div>
</nav>
<div class="container">
  <h1>Your Profile</h1>
  <div class="card">
    <p><strong>Username:</strong> <%= username %></p>
    <p><strong>Role:</strong> <span class="badge badge-<%= role %>"><%= role %></span></p>
  </div>
  <h2>Recovery Key</h2>
  <div id="msg" class="msg hidden"></div>
  <div class="form-group">
    <label>New Recovery Key</label>
    <input type="text" id="rkey" placeholder="Enter a memorable recovery key">
  </div>
  <button class="btn btn-primary">Save Recovery Key</button>
</div>
<script nonce="<%= nonce %>">
const TRACKER_CSRF_TOKEN  = '<%= csrfToken %>';
const TRACKER_CSRF_ACTION = '<%= csrfAction %>';
document.querySelector('button').addEventListener('click', saveKey);
async function saveKey() {
  const key = document.getElementById('rkey').value;
  const resp = await fetch('/api/account/recovery-key', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded',
      'X-CSRF-Token':  TRACKER_CSRF_TOKEN,
      'X-CSRF-Action': TRACKER_CSRF_ACTION
    },
    body: `recovery_key=${encodeURIComponent(key)}`
  });
  const data = await resp.json();
  const msg = document.getElementById('msg');
  msg.textContent = data.status === 'ok' ? 'Recovery key saved!' : (data.error || 'Error');
  msg.className = 'msg ' + (data.status === 'ok' ? 'success' : 'error');
}
</script>
</body>
</html>
